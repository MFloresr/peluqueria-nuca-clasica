---
// Ilustraciones originales de cortes: cabeza sin rostro, con el pelo en formas planas. Una por cada corte de la guía.
interface Props { id: string; pelo?: string; piel?: string; fondo?: string; etiqueta?: string }
const PALETA: Record<string, { pelo: string; piel: string; fondo: string }> = {
  degradado: { pelo: '#1d1a17', piel: '#a9714e', fondo: '#e4d9bd' },
  clasico: { pelo: '#6b4a3a', piel: '#f1c9a8', fondo: '#e9d9bb' },
  tupe: { pelo: '#1d1a17', piel: '#d9a27a', fondo: '#c9a24a' },
  undercut: { pelo: '#c9c5bd', piel: '#f1c9a8', fondo: '#e4ddc8' },
  bob: { pelo: '#1d1a17', piel: '#f1c9a8', fondo: '#e8cfc9' },
  lob: { pelo: '#c47a4a', piel: '#d9a27a', fondo: '#e6d3b0' },
  pixie: { pelo: '#e3c07a', piel: '#f1c9a8', fondo: '#d6e3d3' },
  capas: { pelo: '#6b4a3a', piel: '#a9714e', fondo: '#e4d9bd' },
  cortina: { pelo: '#8c3f33', piel: '#f1c9a8', fondo: '#ecc9bb' },
  rizos: { pelo: '#1d1a17', piel: '#7a4a32', fondo: '#c9a24a' },
};
const p = PALETA[Astro.props.id] ?? PALETA.clasico;
const pelo = Astro.props.pelo ?? p.pelo;
const piel = Astro.props.piel ?? p.piel;
const fondo = Astro.props.fondo ?? p.fondo;
const { id, etiqueta = '' } = Astro.props;
const rizos = Array.from({ length: 13 }, (_, i) => { const a = (Math.PI * (i / 12)) + Math.PI; return [100 + Math.cos(a) * 58, 98 + Math.sin(a) * 62]; });
const rizosLados = [[44, 112], [44, 134], [156, 112], [156, 134], [50, 154], [150, 154]];
---

<svg viewBox="0 0 200 240" role={etiqueta ? 'img' : undefined} aria-label={etiqueta || undefined} aria-hidden={etiqueta ? undefined : 'true'} focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect width="200" height="240" fill={fondo} />
  <!-- Pelo de detrás (largo) -->
  {id === 'bob' && <path d="M48 108C42 52 76 30 100 30C126 30 158 52 152 108L152 150C152 160 144 164 138 158L140 116C130 82 70 82 60 116L62 158C56 164 48 160 48 150Z" fill={pelo} />}
  {id === 'lob' && <path d="M46 108C40 52 76 28 100 28C126 28 160 52 154 108L158 186C158 196 148 198 142 192L140 116C130 82 70 82 60 116L58 192C52 198 42 196 42 186Z" fill={pelo} />}
  {(id === 'capas' || id === 'cortina') && <path d="M44 112C36 52 74 28 100 28C128 28 164 52 156 112L164 196L150 186L148 214L134 196L128 220L118 196L100 218L84 196L72 220L64 196L50 214L50 186L36 196Z" fill={pelo} />}
  {id === 'rizos' && <g fill={pelo}>{rizos.map(([x, y]) => <circle cx={x} cy={y} r="20" />)}{rizosLados.map(([x, y]) => <circle cx={x} cy={y} r="17" />)}</g>}

  <!-- Ropa, cuello y cara -->
  <path d="M8 240C12 204 48 188 100 188C152 188 188 204 192 240Z" fill="#17211b" />
  <rect x="84" y="148" width="32" height="46" rx="12" fill={piel} />
  <path d="M84 168C92 178 108 178 116 168L116 150L84 150Z" fill="#000" opacity="0.1" />
  <ellipse cx="60" cy="110" rx="6" ry="11" fill={piel} />
  <ellipse cx="140" cy="110" rx="6" ry="11" fill={piel} />
  <ellipse cx="100" cy="106" rx="40" ry="50" fill={piel} />

  <!-- Pelo de delante -->
  {id === 'degradado' && (<g fill={pelo}><path d="M62 92C58 52 82 34 102 34C124 34 146 52 140 92C136 74 122 64 100 64C78 64 66 74 62 92Z" /><path d="M60 94C58 108 60 120 64 128L70 112C64 108 62 102 62 92Z" opacity="0.45" /><path d="M140 94C142 108 140 120 136 128L130 112C136 108 138 102 138 92Z" opacity="0.45" /></g>)}
  {id === 'clasico' && (<g><path d="M56 108C50 56 80 36 104 38C132 40 150 62 144 108C142 90 134 74 112 66C92 62 68 76 56 108Z" fill={pelo} /><path d="M84 46C92 52 96 60 96 68" stroke="#000" stroke-opacity="0.25" stroke-width="3" fill="none" stroke-linecap="round" /></g>)}
  {id === 'tupe' && (<g><path d="M60 94C48 44 88 14 128 26C154 34 148 68 140 94C136 74 120 60 100 60C80 60 66 74 60 94Z" fill={pelo} /><path d="M72 52C90 32 118 30 134 40" stroke="#fff" stroke-opacity="0.22" stroke-width="5" fill="none" stroke-linecap="round" /></g>)}
  {id === 'undercut' && (<g fill={pelo}><path d="M66 82C62 40 100 24 136 42C152 50 148 76 138 82C126 66 94 62 66 82Z" /><path d="M62 96C60 106 62 114 66 120L68 100Z" opacity="0.5" /><path d="M138 96C140 106 138 114 134 120L132 100Z" opacity="0.5" /></g>)}
  {id === 'bob' && (<g><path d="M62 92C78 58 120 56 142 88C120 74 86 74 62 92Z" fill={pelo} /><path d="M60 96C58 70 78 56 100 56C122 56 142 70 140 96C130 74 70 74 60 96Z" fill={pelo} /></g>)}
  {id === 'lob' && (<path d="M60 96C58 70 78 56 100 56C122 56 142 70 140 96C130 72 112 66 92 72C80 76 66 84 60 96Z" fill={pelo} />)}
  {id === 'pixie' && (<g fill={pelo}><path d="M58 96C52 54 80 36 104 36C130 36 150 56 144 96C140 82 130 72 114 74C104 66 86 70 78 78C68 78 62 86 58 96Z" /><path d="M78 80C92 70 112 74 122 84L108 80Z" opacity="0.7" /></g>)}
  {id === 'capas' && (<path d="M60 100C58 72 78 54 100 54C122 54 142 72 140 100C132 78 116 68 100 68C84 68 68 78 60 100Z" fill={pelo} />)}
  {id === 'cortina' && (<g fill={pelo}><path d="M100 42C128 42 150 62 148 102C140 82 120 72 100 68Z" /><path d="M100 42C72 42 50 62 52 102C60 82 80 72 100 68Z" /></g>)}
  {id === 'rizos' && (<g fill={pelo}>{[[76, 64], [100, 58], [124, 64], [88, 74], [112, 74]].map(([x, y]) => <circle cx={x} cy={y} r="14" />)}</g>)}
</svg>
