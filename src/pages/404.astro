---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width:720px">
      <h1 style="font-size:clamp(2.6rem,6vw,4.4rem)">Esta página se ha ido a por un corte.</h1>
      <p class="texto">La página que buscas no existe o se ha movido. Vuelve al inicio o pide tu cita.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--sec" href="/cita/">Pedir cita</a></div>
    </div>
  </section>
</Base>
