---
import Base from '../layouts/Base.astro';
import { getEquipo, getServicios } from '../lib/contenido';
import { CATEGORIAS } from '../content.config';
import { sitio } from '../lib/sitio';
import { NOMBRE_CATEGORIA, euros, duracion } from '../lib/util';

const servicios = await getServicios();
const equipo = await getEquipo();
const datos = {
  servicios: servicios.map((s) => ({ id: s.id, nombre: s.data.nombre, categoria: s.data.categoria, duracion: s.data.duracion, precio: s.data.precio, desde: s.data.desde })),
  equipo: equipo.map((p) => ({ id: p.id, nombre: p.data.nombre, cargo: p.data.cargo, especialidad: p.data.especialidad, categorias: p.data.categorias })),
  semana: sitio.semana,
  paso: sitio.cita.paso,
  dias: sitio.cita.diasVista,
};
---

<Base titulo="Pedir cita" descripcion="Pide cita online en cuatro pasos: elige servicios, profesional, día y hora. Ves el precio y la duración al momento.">
  <div class="contenedor cabecera-pagina">
    <h1>Pedir cita</h1>
    <p>Cuatro pasos y listo. Ves el precio y la duración en todo momento, y te confirmamos por teléfono o mensaje.</p>
  </div>
  <section class="seccion" style="padding-top:12px">
    <div class="contenedor cita" id="cita" data-cita={JSON.stringify(datos)} data-endpoint={sitio.endpointFormularios}>
      <div>
        <ol class="pasos" id="pasos" aria-label="Pasos de la reserva">
          <li aria-current="step">Servicios</li>
          <li>Profesional</li>
          <li>Día y hora</li>
          <li>Tus datos</li>
        </ol>

        <form id="form-cita" novalidate>
          <!-- Paso 1 -->
          <section class="paso" data-paso="0" aria-labelledby="h-0">
            <h2 id="h-0" tabindex="-1">¿Qué te vamos a hacer?</h2>
            <p class="gris">Puedes elegir más de un servicio. Te mostramos el tiempo total.</p>
            {CATEGORIAS.map((c) => (
              <div class="grupo-servicios">
                <h3>{NOMBRE_CATEGORIA[c]}</h3>
                {servicios.filter((s) => s.data.categoria === c).map((s) => (
                  <label class="opcion">
                    <input type="checkbox" name="servicio" value={s.id} />
                    <span><strong>{s.data.nombre}</strong><small>{duracion(s.data.duracion)} · {s.data.descripcion}</small></span>
                    <span class="precio-op num">{euros(s.data.precio)}{s.data.desde && <small>desde</small>}</span>
                  </label>
                ))}
              </div>
            ))}
            <p class="error" data-error="servicio" role="alert"></p>
            <div class="acciones"><span></span><button type="button" class="btn" data-sig>Siguiente: profesional</button></div>
          </section>

          <!-- Paso 2 -->
          <section class="paso" data-paso="1" aria-labelledby="h-1" hidden>
            <h2 id="h-1" tabindex="-1">¿Con quién?</h2>
            <p class="gris" id="p-ayuda-pro">Si no tienes preferencia, te asignamos a quien tenga hueco.</p>
            <div class="profesionales" role="radiogroup" aria-labelledby="h-1" id="lista-pro"></div>
            <div class="acciones"><button type="button" class="btn btn--sec" data-atras>Atrás</button><button type="button" class="btn" data-sig>Siguiente: día y hora</button></div>
          </section>

          <!-- Paso 3 -->
          <section class="paso" data-paso="2" aria-labelledby="h-2" hidden>
            <h2 id="h-2" tabindex="-1">¿Cuándo te viene bien?</h2>
            <fieldset style="border:0;padding:0;margin:0 0 10px;min-width:0">
              <legend style="font:700 1rem var(--f-texto);margin-bottom:8px">Día</legend>
              <div class="dias" id="lista-dias"></div>
            </fieldset>
            <fieldset style="border:0;padding:0;margin:0;min-width:0">
              <legend style="font:700 1rem var(--f-texto);margin-bottom:8px">Hora</legend>
              <p class="gris" id="aviso-horas" role="status" aria-live="polite" style="margin:0 0 8px">Elige primero un día.</p>
              <div class="horas" id="lista-horas"></div>
            </fieldset>
            <p class="error" data-error="fecha" role="alert"></p>
            <div class="acciones"><button type="button" class="btn btn--sec" data-atras>Atrás</button><button type="button" class="btn" data-sig>Siguiente: tus datos</button></div>
          </section>

          <!-- Paso 4 -->
          <section class="paso" data-paso="3" aria-labelledby="h-3" hidden>
            <h2 id="h-3" tabindex="-1">Tus datos</h2>
            <div class="formulario" style="padding:20px">
              <div class="rejilla-campos">
                <div><label for="c-nombre">Nombre <span class="marca" aria-hidden="true">*</span></label><input id="c-nombre" name="nombre" type="text" autocomplete="name" required /><p class="error" data-error-para="nombre"></p></div>
                <div><label for="c-tel">Teléfono <span class="marca" aria-hidden="true">*</span></label><input id="c-tel" name="telefono" type="tel" autocomplete="tel" required pattern="[0-9 +]{9,}" title="Escribe un teléfono de al menos 9 cifras" /><p class="error" data-error-para="telefono"></p></div>
                <div class="ancho-total"><label for="c-email">Correo (opcional)</label><input id="c-email" name="email" type="email" autocomplete="email" /></div>
                <div class="ancho-total">
                  <label for="c-nota">¿Algo que debamos saber? (opcional)</label>
                  <textarea id="c-nota" name="nota" maxlength="300" style="min-height:90px"></textarea>
                  <p class="ayuda">Por ejemplo, una foto de referencia que llevarás, o si es tu primera vez. No hace falta que nos cuentes datos de salud.</p>
                </div>
                <div class="ancho-total">
                  <label class="casilla"><input type="checkbox" name="consentimiento" required /><span>He leído la <a href="/privacidad/">política de privacidad</a> y las <a href="/condiciones-de-reserva/">condiciones de reserva</a>, y acepto que se usen mis datos para gestionar mi cita.</span></label>
                  <p class="error" data-error-para="consentimiento"></p>
                </div>
                <div class="honeypot" aria-hidden="true"><label>No rellenes este campo <input type="text" name="web" tabindex="-1" autocomplete="off" /></label></div>
              </div>
            </div>
            <div role="status" aria-live="polite" id="estado-cita"></div>
            <div class="acciones"><button type="button" class="btn btn--sec" data-atras>Atrás</button><button type="submit" class="btn" id="enviar-cita">Confirmar la cita</button></div>
          </section>
        </form>

        <div id="confirmacion" hidden tabindex="-1">
          <p class="aviso aviso--demo" style="margin-top:0">Modo demostración: la cita no se ha reservado de verdad y no se ha enviado nada.</p>
          <h2 style="font-size:2rem">Solicitud recibida</h2>
          <p id="conf-texto" class="texto"></p>
          <p><a class="btn" href="/">Volver al inicio</a> <a class="enlace" style="margin-left:14px" href="/cita/">Pedir otra cita</a></p>
        </div>
      </div>

      <aside class="resumen" aria-labelledby="t-resumen">
        <h2 id="t-resumen">Tu cita</h2>
        <div id="res-servicios"><p class="vacio-res">Aún no has elegido servicios.</p></div>
        <dl>
          <div><dt>Duración total</dt><dd id="res-duracion">–</dd></div>
          <div><dt>Profesional</dt><dd id="res-pro">Quien tenga hueco</dd></div>
          <div><dt>Día y hora</dt><dd id="res-fecha">Por elegir</dd></div>
        </dl>
        <p class="total"><span>Total</span><span class="num" id="res-total">0 €</span></p>
        <p style="font-size:0.85rem;color:#b9c2b4;margin:10px 0 0">Los servicios con «desde» pueden costar más según la longitud. Te damos el precio final antes de empezar.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  type S = { id: string; nombre: string; categoria: string; duracion: number; precio: number; desde: boolean };
  type Pro = { id: string; nombre: string; cargo: string; especialidad: string; categorias: string[] };
  const raiz = document.getElementById('cita')!;
  const D: { servicios: S[]; equipo: Pro[]; semana: Record<string, string[][]>; paso: number; dias: number } = JSON.parse(raiz.dataset.cita || '{}');
  const form = document.getElementById('form-cita') as HTMLFormElement;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const eur = (n: number) => `${new Intl.NumberFormat('es-ES').format(n)} €`;
  const dur = (m: number) => { const h = Math.floor(m / 60), r = m % 60; return h ? (r ? `${h} h ${r} min` : `${h} h`) : `${r} min`; };
  const hm = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  const aMin = (h: string) => Number(h.slice(0, 2)) * 60 + Number(h.slice(3, 5));
  let paso = 0;

  const elegidos = () => [...form.querySelectorAll<HTMLInputElement>('input[name="servicio"]:checked')].map((i) => D.servicios.find((s) => s.id === i.value)!);
  const duracionTotal = () => elegidos().reduce((s, x) => s + x.duracion, 0);
  const proElegido = () => form.querySelector<HTMLInputElement>('input[name="profesional"]:checked')?.value ?? '';
  const fechaElegida = () => form.querySelector<HTMLInputElement>('input[name="fecha"]:checked')?.value ?? '';
  const horaElegida = () => form.querySelector<HTMLInputElement>('input[name="hora"]:checked')?.value ?? '';

  // Quién puede hacer todos los servicios elegidos
  const capaces = () => { const cats = new Set(elegidos().map((s) => s.categoria)); return D.equipo.filter((p) => [...cats].every((c) => p.categorias.includes(c))); };

  // Huecos ocupados simulados: determinista por día, profesional y hora (en una web real vendría del calendario)
  const ocupado = (fecha: string, pro: string, min: number) => {
    let h = 7; const t = `${fecha}|${pro}|${min}`;
    for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) % 1009;
    return h % 100 < 32;
  };
  const libre = (fecha: string, pro: string, inicio: number, total: number) => {
    for (let m = inicio; m < inicio + total; m += D.paso) if (ocupado(fecha, pro, m)) return false;
    return true;
  };

  function pintarResumen() {
    const el = elegidos();
    $('res-servicios').innerHTML = el.length ? `<ul>${el.map((s) => `<li><span>${s.nombre}</span><span class="num">${eur(s.precio)}${s.desde ? '+' : ''}</span></li>`).join('')}</ul>` : '<p class="vacio-res">Aún no has elegido servicios.</p>';
    $('res-duracion').textContent = el.length ? dur(duracionTotal()) : '–';
    $('res-total').textContent = eur(el.reduce((s, x) => s + x.precio, 0));
    const pro = D.equipo.find((p) => p.id === proElegido());
    $('res-pro').textContent = pro ? pro.nombre : 'Quien tenga hueco';
    const f = fechaElegida(), h = horaElegida();
    $('res-fecha').textContent = f && h ? `${new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(f + 'T12:00:00'))}, ${h}` : f ? 'Elige la hora' : 'Por elegir';
  }

  function pintarPro() {
    const ok = new Set(capaces().map((p) => p.id));
    const actual = proElegido() || '';
    $('lista-pro').innerHTML = [{ id: '', nombre: 'Quien tenga hueco', cargo: 'Te asignamos al primero libre', especialidad: '', categorias: [] as string[] }, ...D.equipo].map((p) => {
      const habilitado = p.id === '' || ok.has(p.id);
      return `<label class="profesional"><input type="radio" name="profesional" value="${p.id}" ${actual === p.id ? 'checked' : ''} ${habilitado ? '' : 'disabled'} /><span><strong>${p.nombre}</strong><small>${p.id ? `${p.cargo} · ${p.especialidad}${habilitado ? '' : ' · no hace alguno de los servicios elegidos'}` : p.cargo}</small></span></label>`;
    }).join('');
    if (!form.querySelector('input[name="profesional"]:checked')) form.querySelector<HTMLInputElement>('input[name="profesional"][value=""]')!.checked = true;
  }

  function pintarDias() {
    const ahora = new Date();
    const dias: string[] = [];
    for (let i = 0; i < D.dias; i++) { const d = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate() + i); dias.push(`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`); }
    const previo = fechaElegida();
    $('lista-dias').innerHTML = dias.map((f) => {
      const d = new Date(f + 'T12:00:00'), tramos = D.semana[String(d.getDay())] ?? [];
      const nombre = new Intl.DateTimeFormat('es-ES', { weekday: 'short' }).format(d);
      return `<label><input type="radio" name="fecha" value="${f}" ${tramos.length === 0 ? 'disabled' : ''} ${previo === f ? 'checked' : ''} /><span>${nombre}<b>${d.getDate()}</b>${new Intl.DateTimeFormat('es-ES', { month: 'short' }).format(d)}${tramos.length === 0 ? '<small class="solo-lectores"> cerrado</small>' : ''}</span></label>`;
    }).join('');
  }

  function pintarHoras() {
    const f = fechaElegida(), total = duracionTotal(), cont = $('lista-horas'), aviso = $('aviso-horas');
    if (!f) { cont.innerHTML = ''; aviso.textContent = 'Elige primero un día.'; return; }
    const pro = proElegido();
    const profesionales = pro ? [pro] : capaces().map((p) => p.id);
    const tramos = D.semana[String(new Date(f + 'T12:00:00').getDay())] ?? [];
    const ahora = new Date(); const hoy = `${ahora.getFullYear()}-${String(ahora.getMonth() + 1).padStart(2, '0')}-${String(ahora.getDate()).padStart(2, '0')}`;
    const minAhora = ahora.getHours() * 60 + ahora.getMinutes() + 120; // al menos dos horas de antelación
    const previa = horaElegida();
    const opciones: { h: string; libre: boolean }[] = [];
    for (const [a, c] of tramos) for (let m = aMin(a); m + total <= aMin(c); m += D.paso) {
      const pasado = f === hoy && m < minAhora;
      opciones.push({ h: hm(m), libre: !pasado && profesionales.some((p) => libre(f, p, m, total)) });
    }
    const libres = opciones.filter((o) => o.libre).length;
    aviso.textContent = libres ? `${libres} horas libres para ${dur(total)} de servicio.` : 'No quedan huecos ese día. Prueba con otro día o con otro profesional.';
    cont.innerHTML = opciones.map((o) => `<label><input type="radio" name="hora" value="${o.h}" ${o.libre ? '' : 'disabled'} ${previa === o.h && o.libre ? 'checked' : ''} /><span>${o.h}</span></label>`).join('');
  }

  const titulo = (n: number) => $(`h-${n}`);
  function ir(n: number) {
    paso = n;
    form.querySelectorAll<HTMLElement>('.paso').forEach((s) => (s.hidden = Number(s.dataset.paso) !== n));
    document.querySelectorAll<HTMLElement>('#pasos li').forEach((li, i) => { if (i === n) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current'); if (i < n) li.setAttribute('data-hecho', ''); else li.removeAttribute('data-hecho'); });
    if (n === 1) pintarPro();
    if (n === 2) { pintarDias(); pintarHoras(); }
    titulo(n).focus(); titulo(n).scrollIntoView({ block: 'start', behavior: 'smooth' });
    pintarResumen();
  }

  const err = (k: string, t: string) => { const e = form.querySelector<HTMLElement>(`[data-error="${k}"]`); if (e) e.textContent = t; };
  function validarPaso(n: number) {
    if (n === 0) { if (!elegidos().length) { err('servicio', 'Elige al menos un servicio para continuar.'); return false; } err('servicio', ''); return true; }
    if (n === 2) { if (!fechaElegida() || !horaElegida()) { err('fecha', !fechaElegida() ? 'Elige un día.' : 'Elige una hora.'); return false; } err('fecha', ''); return true; }
    return true;
  }
  form.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.hasAttribute('data-sig') && validarPaso(paso)) ir(paso + 1);
    else if (b.hasAttribute('data-atras')) ir(paso - 1);
  });
  form.addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    if (i.name === 'servicio') { err('servicio', ''); pintarPro(); }
    if (i.name === 'profesional' || i.name === 'fecha') pintarHoras();
    if (i.name === 'fecha' || i.name === 'hora') err('fecha', '');
    pintarResumen();
  });

  // Servicio preseleccionado desde la dirección (?servicio=degradado)
  const q = new URLSearchParams(location.search);
  q.getAll('servicio').forEach((v) => { const i = form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${v}"]`); if (i) i.checked = true; });
  pintarResumen();

  // Envío
  const campos = () => [...form.querySelectorAll<HTMLInputElement>('input[required]')].filter((c) => c.name !== 'servicio');
  const mensaje = (c: HTMLInputElement) => (c.validity.valueMissing ? (c.type === 'checkbox' ? 'Necesitamos que aceptes la política y las condiciones.' : 'Este campo es obligatorio.') : c.validity.patternMismatch ? c.title : '');
  const validar = (c: HTMLInputElement) => { const m = mensaje(c); const e = form.querySelector<HTMLElement>(`[data-error-para="${c.name}"]`); if (e) e.textContent = m; c.setAttribute('aria-invalid', m ? 'true' : 'false'); return !m; };
  campos().forEach((c) => c.addEventListener('blur', () => validar(c)));
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const ok = campos().map(validar);
    if (ok.includes(false)) { campos().find((c) => c.getAttribute('aria-invalid') === 'true')?.focus(); return; }
    const datos = Object.fromEntries(new FormData(form).entries());
    if (datos.web) return;
    const boton = $<HTMLButtonElement>('enviar-cita'); boton.disabled = true; boton.textContent = 'Enviando…';
    const cuerpo = { tipo: 'cita', servicios: elegidos().map((s) => s.id), profesional: proElegido() || 'cualquiera', fecha: fechaElegida(), hora: horaElegida(), duracion: duracionTotal(), nombre: datos.nombre, telefono: datos.telefono, email: datos.email, nota: datos.nota };
    try {
      const url = raiz.dataset.endpoint;
      if (url) { const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) }); if (!r.ok) throw new Error(String(r.status)); }
      const f = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(cuerpo.fecha + 'T12:00:00'));
      $('conf-texto').textContent = `Gracias, ${String(cuerpo.nombre).split(' ')[0]}. Hemos recibido tu solicitud para el ${f} a las ${cuerpo.hora} (${dur(cuerpo.duracion)}). Te confirmamos por teléfono o mensaje.`;
      form.hidden = true; $('pasos').hidden = true; $('confirmacion').hidden = false; $('confirmacion').focus();
    } catch {
      $('estado-cita').innerHTML = '<p class="aviso aviso--error">No hemos podido enviar la solicitud. Inténtalo de nuevo o llámanos.</p>';
      boton.disabled = false; boton.textContent = 'Confirmar la cita';
    }
  });
</script>
